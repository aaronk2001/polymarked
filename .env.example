# SQLite (single-file desktop DB)
DATABASE_URL=sqlite+aiosqlite:///./data/polymarked.db

# Telegram (single-user owner gating)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=0

# Polymarket auth (only required for TRADE_MODE=live)
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_CHAIN_ID=137
POLYMARKET_SIGNATURE_TYPE=0
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Trade mode: off | paper | live
# - off:   record decisions only, no fills
# - paper: virtual fills + virtual PnL (no wallet/keys required)
# - live:  sign + post real CLOB orders (requires POLYMARKET_PRIVATE_KEY etc.)
TRADE_MODE=paper

# Defaults applied to new follows
DEFAULT_COPY_RATIO=0.01
DEFAULT_MAX_PER_TRADE_USD=25
DEFAULT_DAILY_LOSS_CAP_USD=100

# Watcher
WATCH_POLL_INTERVAL_SECONDS=15
WATCH_MAX_BACKFILL_HOURS=24

# Ollama narration: one-line summary appended to Telegram trade alerts.
# Text only; runs after the decision is recorded. No-ops if Ollama is down.
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:0.5b-instruct

# In-app dashboard server (bound localhost-only)
API_HOST=127.0.0.1
API_PORT=8765

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CLOB endpoint and RPC. Override for testnet validation.
# Mainnet defaults shown; for Polygon Amoy use chain_id=80002 + Amoy RPC.
CLOB_HOST=https://clob.polymarket.com
POLYGON_RPC_URL=https://polygon-rpc.com
